# Bu dosyayı ".env" adıyla kopyalayın:  cp .env.example .env   (Windows: copy .env.example .env)
# .env dosyası git'e GÖNDERİLMEZ.

# --- Veri kaynağı ---
# mock      : Örnek (sahte) verilerle çalışır. İnternet/Scholar gerekmez. Arayüz geliştirme için.
# playwright: Google Scholar'ı headless Chromium ile tarar (ücretsiz, hız sınırlı).
# serpapi   : SerpAPI üzerinden Google Scholar (ücretli/ücretsiz kota, en güvenilir).
SCHOLAR_PROVIDER=mock
SERPAPI_KEY=

# OpenAlex / Crossref / Unpaywall "polite pool" için iletişim e-postası (zorunlu tavsiye edilir)
CONTACT_EMAIL=ornek@mehmetakif.edu.tr

# Opsiyonel: Elsevier/Scopus API anahtarı (kurum IP'sinden çalışır)
ELSEVIER_API_KEY=

# WoS / Scopus girişi (paylaşımlı tarayıcı, arayüzde gömülü görünür)
# true: giriş doğrulanmadan dizin taraması ve kanıt üretimi başlamaz (mock modda atlanabilir)
REQUIRE_DB_LOGIN=true
NOVNC_PUBLIC_URL=http://localhost:6080

# Scraping davranışı
SCRAPE_MIN_DELAY_SEC=4
SCRAPE_MAX_DELAY_SEC=9
CACHE_TTL_HOURS=72

# Altyapı (docker-compose içinde değiştirmeye gerek yok)
DATABASE_URL=postgresql+psycopg://tesvik:tesvik@db:5432/tesvik
REDIS_URL=redis://redis:6379/0
DATA_DIR=/data
GROBID_URL=http://grobid:8070
BROWSER_CDP_HOST=browser
BROWSER_CDP_PORT=9223
